---
import ArrowRight from '@lucide/astro/icons/arrow-right';
import CalendarDays from '@lucide/astro/icons/calendar-days';
import Clock3 from '@lucide/astro/icons/clock-3';
import Mail from '@lucide/astro/icons/mail';
import MapPin from '@lucide/astro/icons/map-pin';
import Phone from '@lucide/astro/icons/phone';
import Send from '@lucide/astro/icons/send';
import BaseLayout from '../layouts/BaseLayout.astro';
import FloatingActions from '../components/common/FloatingActions.astro';
import ScrollToTop from '../components/common/ScrollToTop.astro';
import SiteFooter from '../components/common/SiteFooter.astro';
import SiteHeader from '../components/common/SiteHeader.astro';

const contactMethods = [
	{
		href: null,
		icon: Phone,
		links: [
			{ href: 'tel:+37129373231', value: '+371 29 373 231' },
			{ href: 'tel:+37126488094', value: '+371 26 488 094' },
		],
		title: 'Tālruņi',
		value: null,
	},
	{
		href: 'mailto:info@liepajasteltis.lv',
		icon: Mail,
		links: null,
		title: 'E-pasts',
		value: 'info@liepajasteltis.lv',
	},
	{
		href: 'https://www.google.com/maps/search/?api=1&query=Liep%C4%81ja%2C%20Ro%C5%86u%20iela%208',
		icon: MapPin,
		links: null,
		title: 'Adrese',
		value: 'Liepāja,\nRoņu iela 8',
	},
	{
		href: null,
		icon: Clock3,
		links: null,
		title: 'Darba laiks',
		value: '24/7',
	},
];
---

<BaseLayout title="Kontakti | Liepājas teltis" description="Sazinieties ar Liepājas teltis par telšu un inventāra nomu jūsu pasākumam.">
	<SiteHeader />
	<main class="page-shell contact-page" aria-labelledby="contact-page-title">
		<FloatingActions />
		<ScrollToTop />

		<section class="contact-page__hero" data-reveal="up">
			<nav class="breadcrumb-trail contact-page__breadcrumbs" aria-label="Lapas ceļš">
				<a href="/">Sākums</a>
				<ArrowRight aria-hidden="true" />
				<span>Kontakti</span>
			</nav>

			<div class="contact-page__intro">
				<h1 id="contact-page-title">Kontakti</h1>
				<div class="contact-page__rule" aria-hidden="true"></div>
				<p>Sazinieties ar mums - mēs ar prieku palīdzēsim plānot jūsu pasākumu!</p>
			</div>
		</section>

		<section class="contact-methods" aria-label="Kontaktinformācija" data-reveal="up">
			{
				contactMethods.map(({ href, icon: Icon, links, title, value }) => {
					const content = (
						<>
							<Icon aria-hidden="true" />
							<strong>{title}</strong>
							{
								links ? (
									<span class="contact-method__links">
										{links.map((link) => (
											<a href={link.href} aria-label={`Zvanīt ${link.value}`}>{link.value}</a>
										))}
									</span>
								) : (
									<span>{value}</span>
								)
							}
						</>
					);

					return href ? (
						<a class="contact-method" href={href}>
							{content}
						</a>
					) : (
						<div class="contact-method">{content}</div>
					);
				})
			}
		</section>

		<section class="contact-map" aria-label="Atrašanās vieta" data-reveal="up">
			<iframe
				class="contact-map__iframe"
				title="Liepājas Teltis atrašanās vieta Google Maps"
				src="https://www.google.com/maps?q=Liep%C4%81ja%2C%20Ro%C5%86u%20iela%208&output=embed"
				loading="lazy"
				referrerpolicy="no-referrer-when-downgrade"
				allowfullscreen
			></iframe>
			<div class="contact-map__card">
				<h2>Liepājas Teltis</h2>
				<p>Liepāja,<br />Roņu iela 8</p>
				<a href="https://www.google.com/maps/search/?api=1&query=Liep%C4%81ja%2C%20Ro%C5%86u%20iela%208" target="_blank" rel="noreferrer">
					<span>Skatīt kartē</span>
					<ArrowRight aria-hidden="true" />
				</a>
			</div>
		</section>

		<section class="contact-cta" aria-label="Pieteikt nomu" data-reveal="left">
			<div class="contact-cta__icon">
				<CalendarDays aria-hidden="true" />
			</div>
			<div>
				<h2>Plāno savu pasākumu?</h2>
				<p>Mēs palīdzēsim radīt tieši tādu atmosfēru, kādu esi iecerējis.</p>
			</div>
			<a href="/pieteikt-nomu">
				<span>Pieteikt nomu</span>
				<Send aria-hidden="true" />
			</a>
		</section>
	</main>
	<SiteFooter />
</BaseLayout>

<style>
	.contact-page {
		position: relative;
		padding: clamp(1.6rem, 3.8vw, 3.1rem) clamp(1rem, 3vw, 1.5rem) 0;
		overflow: hidden;
		background: var(--color-background);
	}

	.contact-page::before {
		position: absolute;
		left: max(-4rem, calc(50% - 47rem));
		top: 10rem;
		width: clamp(8rem, 16vw, 13rem);
		height: clamp(6rem, 11vw, 9rem);
		background-image: radial-gradient(circle, rgba(155, 135, 115, 0.28) 1.25px, transparent 1.55px);
		background-size: 0.82rem 0.82rem;
		content: "";
		opacity: 0.78;
		pointer-events: none;
	}

	.contact-page__hero,
	.contact-methods,
	.contact-map,
	.contact-cta {
		position: relative;
		z-index: 1;
		width: min(100%, 1160px);
		margin-inline: auto;
	}

	.contact-page__breadcrumbs {
		margin-bottom: clamp(1.5rem, 2.7vw, 2rem);
	}

	.contact-page__intro {
		max-width: 34rem;
	}

	.contact-page__intro h1,
	.contact-cta h2 {
		margin: 0;
		color: var(--color-bark);
		font-family: Georgia, "Times New Roman", serif;
		font-weight: 500;
		letter-spacing: 0;
	}

	.contact-page__intro h1 {
		font-size: clamp(2.8rem, 5.6vw, 4.45rem);
		line-height: 1;
	}

	.contact-page__rule {
		width: 2.8rem;
		height: 1px;
		margin: 1rem 0 1.1rem;
		background: var(--color-primary);
	}

	.contact-page__intro p {
		max-width: 25rem;
		margin: 0;
		color: var(--color-text-muted);
		font-size: clamp(0.95rem, 1.2vw, 1.05rem);
		font-weight: 500;
		line-height: 1.68;
	}

	.contact-methods {
		margin-top: clamp(2.7rem, 5vw, 4.2rem);
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		overflow: hidden;
		background: rgba(255, 255, 255, 0.44);
		border: 1px solid rgba(222, 212, 198, 0.78);
		border-radius: 8px;
		box-shadow: 0 16px 38px rgba(75, 64, 56, 0.05);
	}

	.contact-method {
		min-height: 8.6rem;
		padding: 1rem clamp(1rem, 2.4vw, 2.4rem);
		display: grid;
		place-items: center;
		align-content: center;
		color: var(--color-bark);
		text-align: center;
		text-decoration: none;
		border-right: 1px solid rgba(185, 167, 143, 0.42);
	}

	.contact-method:last-child {
		border-right: 0;
	}

	.contact-method:hover {
		color: var(--color-bark);
		transform: translateY(-2px);
	}

	.contact-method svg {
		width: 1.8rem;
		height: 1.8rem;
		margin-bottom: 1.1rem;
		color: var(--color-primary);
		stroke-width: 1.8;
	}

	.contact-method strong {
		display: block;
		margin-bottom: 0.55rem;
		color: var(--color-bark);
		font-family: Georgia, "Times New Roman", serif;
		font-size: 1.05rem;
		font-weight: 500;
		line-height: 1.2;
	}

	.contact-method span {
		white-space: pre-line;
		color: var(--color-text-muted);
		font-size: 0.88rem;
		font-weight: 560;
		line-height: 1.55;
	}

	.contact-method__links {
		width: 100%;
		display: grid;
		justify-items: center;
		gap: 0;
		white-space: normal;
		line-height: 1.3;
	}

	.contact-method__links a {
		min-width: 8.8rem;
		padding: 0.18rem 0.35rem;
		color: #66704f;
		font-size: 0.86rem;
		font-weight: 720;
		line-height: 1.35;
		text-align: center;
		text-decoration: none;
		white-space: nowrap;
		border-radius: 4px;
		transition:
			color 160ms ease,
			background-color 160ms ease;
	}

	.contact-method__links a + a {
		margin-top: 0.28rem;
		padding-top: 0.48rem;
		border-top: 1px solid rgba(185, 167, 143, 0.52);
	}

	.contact-method__links a:hover,
	.contact-method__links a:focus-visible {
		color: var(--color-bark);
		background: rgba(138, 146, 113, 0.12);
		outline: none;
	}

	.contact-method__links a:focus-visible {
		box-shadow: var(--focus-ring);
	}

	.contact-cta a {
		min-height: 2.75rem;
		padding: 0 1.45rem;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 0.75rem;
		color: var(--color-surface);
		background: #4f5d32;
		border: 0;
		border-radius: 999px;
		box-shadow: 0 14px 28px rgba(79, 93, 50, 0.2);
		cursor: pointer;
		font: inherit;
		font-size: 0.75rem;
		font-weight: 850;
		letter-spacing: 0.06em;
		text-decoration: none;
		text-transform: uppercase;
	}

	.contact-cta a:hover {
		color: var(--color-surface);
		background: var(--color-primary-hover);
		transform: translateY(-2px);
	}

	.contact-cta a svg {
		width: 1rem;
		height: 1rem;
	}

	.contact-map {
		position: relative;
		height: clamp(15rem, 29vw, 19rem);
		margin-top: clamp(2.2rem, 4vw, 3.2rem);
		overflow: hidden;
		background: #e9e1d4;
		border-radius: 8px;
		box-shadow: 0 20px 48px rgba(75, 64, 56, 0.08);
	}

	.contact-map__iframe {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		border: 0;
	}

	.contact-map__card {
		position: absolute;
		top: 50%;
		left: clamp(1.2rem, 3vw, 2.4rem);
		z-index: 1;
		width: min(15rem, calc(100% - 2rem));
		padding: 1.25rem 1.35rem;
		background: rgba(255, 255, 255, 0.88);
		border: 1px solid rgba(222, 212, 198, 0.84);
		border-radius: 8px;
		box-shadow: var(--shadow-soft);
		transform: translateY(-50%);
	}

	.contact-map__card h2 {
		margin: 0;
		color: var(--color-bark);
		font-family: Georgia, "Times New Roman", serif;
		font-size: 1.15rem;
		font-weight: 500;
	}

	.contact-map__card p {
		margin: 0.65rem 0 0.9rem;
		color: var(--color-text-muted);
		font-size: 0.86rem;
		font-weight: 560;
		line-height: 1.48;
	}

	.contact-map__card a {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		color: var(--color-bark);
		font-size: 0.8rem;
		font-weight: 700;
		text-decoration: none;
	}

	.contact-map__card a svg {
		width: 0.9rem;
		height: 0.9rem;
	}

	.contact-cta {
		margin-top: clamp(1.6rem, 3.2vw, 2.4rem);
		margin-bottom: clamp(2.2rem, 4vw, 3.2rem);
		padding: clamp(1rem, 2vw, 1.4rem) clamp(1.2rem, 3vw, 2rem);
		display: grid;
		grid-template-columns: auto minmax(0, 1fr) auto;
		align-items: center;
		gap: clamp(1rem, 2.4vw, 1.6rem);
		background: rgba(255, 255, 255, 0.44);
		border: 1px solid rgba(222, 212, 198, 0.84);
		border-radius: 8px;
		box-shadow: 0 14px 34px rgba(75, 64, 56, 0.06);
	}

	.contact-cta__icon {
		width: clamp(3.5rem, 6vw, 5rem);
		height: clamp(3.5rem, 6vw, 5rem);
		display: grid;
		place-items: center;
		color: var(--color-primary);
		background: rgba(237, 228, 215, 0.75);
		border: 1px solid rgba(222, 212, 198, 0.92);
		border-radius: 8px;
	}

	.contact-cta__icon svg {
		width: 1.8rem;
		height: 1.8rem;
		stroke-width: 1.7;
	}

	.contact-cta h2 {
		font-size: clamp(1.45rem, 2.6vw, 2rem);
		line-height: 1.1;
	}

	.contact-cta p {
		max-width: 24rem;
		margin: 0.35rem 0 0;
		color: var(--color-text-muted);
		font-size: 0.9rem;
		font-weight: 560;
		line-height: 1.48;
	}

	@media (max-width: 860px) {
		.contact-methods {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}

		.contact-method {
			border-right: 0;
			border-bottom: 1px solid rgba(185, 167, 143, 0.32);
		}

		.contact-method:nth-child(odd) {
			border-right: 1px solid rgba(185, 167, 143, 0.32);
		}

		.contact-method:nth-last-child(-n + 2) {
			border-bottom: 0;
		}

		.contact-cta {
			grid-template-columns: auto minmax(0, 1fr);
		}

		.contact-cta a {
			grid-column: 1 / -1;
			width: fit-content;
		}
	}

	@media (max-width: 640px) {
		.contact-page {
			padding-inline: 1rem;
			padding-top: 1.25rem;
		}

		.contact-page::before {
			left: -6rem;
			top: 8rem;
			width: 13rem;
			height: 9rem;
			opacity: 0.46;
		}

		.contact-page__breadcrumbs {
			margin-bottom: 1.1rem;
		}

		.contact-page__intro h1 {
			font-size: clamp(2.35rem, 11.5vw, 3.05rem);
		}

		.contact-page__intro p {
			font-size: 0.92rem;
			line-height: 1.58;
		}

		.contact-methods {
			margin-top: 2.1rem;
		}

		.contact-method {
			min-height: 7.8rem;
			padding: 0.7rem 0.75rem;
		}

		.contact-method svg {
			width: 1.7rem;
			height: 1.7rem;
			margin-bottom: 1rem;
		}

		.contact-method strong {
			font-size: 0.98rem;
		}

		.contact-method span {
			font-size: 0.78rem;
		}

		.contact-method__links a {
			min-width: 0;
			width: 100%;
			padding-inline: 0.1rem;
			font-size: 0.75rem;
		}

		.contact-map {
			height: 19rem;
			margin-top: 1.4rem;
		}

		.contact-map__card {
			top: auto;
			left: 1rem;
			bottom: 1rem;
			padding: 1rem;
			transform: none;
		}

		.contact-cta {
			margin-top: 1.2rem;
			grid-template-columns: 1fr;
			text-align: left;
		}

		.contact-cta a {
			width: 100%;
		}
	}
</style>

---
import '../styles/global.css';
import CartDrawer from '../components/common/CartDrawer.astro';
import CookieConsent from '../components/CookieConsent.astro';
import ScrollAnimations from '../components/common/ScrollAnimations.astro';

interface Props {
	title?: string;
	description?: string;
	image?: string;
	noindex?: boolean;
	resetScrollOnLoad?: boolean;
	structuredData?: Record<string, unknown> | Record<string, unknown>[];
}

const {
	title = 'Telšu noma Liepājā un visā Latvijā | Liepājas teltis',
	description = 'Liepājas teltis piedāvā pasākumu telšu un inventāra nomu ar piegādi un uzstādīšanu Liepājā un visā Latvijā.',
	image = '/og-image.png',
	noindex = false,
	resetScrollOnLoad = false,
	structuredData,
} = Astro.props;

const siteUrl = 'https://liepajasteltis.lv';
const logoUrl = `${siteUrl}/logo.png`;
const socialProfiles = [
	'https://www.facebook.com/profile.php?id=61592843150289',
	'https://www.instagram.com/liepajasteltis/',
	'https://www.tiktok.com/@liepajasteltis',
];
const canonicalUrl = new URL(Astro.url.pathname, siteUrl);
canonicalUrl.hash = '';
canonicalUrl.search = '';

const imageUrl = new URL(image, siteUrl);
const isPngImage = imageUrl.pathname.toLowerCase().endsWith('.png');
const isJpegImage = /\.(jpe?g)$/i.test(imageUrl.pathname);
const imageType = isPngImage ? 'image/png' : isJpegImage ? 'image/jpeg' : undefined;
const normalizedTitle = title.includes('Liepājas teltis') || title.includes('Liepājas Teltis') ? title : `${title} | Liepājas teltis`;
const organizationSchema = {
	'@context': 'https://schema.org',
	'@type': 'LocalBusiness',
	'@id': `${siteUrl}/#business`,
	name: 'Liepājas Teltis',
	alternateName: 'Liepājas teltis',
	legalName: 'SIA LBG',
	url: siteUrl,
	description: 'Pasākumu telšu un inventāra noma ar piegādi un uzstādīšanu Liepājā, Kurzemē un visā Latvijā.',
	image: imageUrl.href,
	logo: {
		'@type': 'ImageObject',
		'@id': `${siteUrl}/#logo`,
		url: logoUrl,
		contentUrl: logoUrl,
		width: 1024,
		height: 1024,
	},
	sameAs: socialProfiles,
	email: 'info@liepajasteltis.lv',
	telephone: ['+37129373231', '+37126488094'],
	contactPoint: [
		{
			'@type': 'ContactPoint',
			telephone: '+37129373231',
			contactType: 'customer service',
			areaServed: 'LV',
			availableLanguage: ['lv'],
		},
		{
			'@type': 'ContactPoint',
			telephone: '+37126488094',
			contactType: 'customer service',
			areaServed: 'LV',
			availableLanguage: ['lv'],
		},
	],
	taxID: '40103955467',
	vatID: 'LV40103955467',
	address: {
		'@type': 'PostalAddress',
		addressCountry: 'LV',
		addressLocality: 'Liepāja',
		addressRegion: 'Kurzeme',
		streetAddress: 'Roņu iela 8',
	},
	hasMap: 'https://www.google.com/maps/search/?api=1&query=Liep%C4%81ja%2C%20Ro%C5%86u%20iela%208',
	areaServed: [
		{
			'@type': 'City',
			name: 'Liepāja',
		},
		{
			'@type': 'AdministrativeArea',
			name: 'Kurzeme',
		},
		{
			'@type': 'Country',
			name: 'Latvia',
		},
	],
	priceRange: '€€',
};
const websiteSchema = {
	'@context': 'https://schema.org',
	'@type': 'WebSite',
	'@id': `${siteUrl}/#website`,
	name: 'Liepājas Teltis',
	url: siteUrl,
	inLanguage: 'lv-LV',
	publisher: {
		'@id': `${siteUrl}/#business`,
	},
};
const pageSchema = {
	'@context': 'https://schema.org',
	'@type': 'WebPage',
	'@id': `${canonicalUrl.href}#webpage`,
	url: canonicalUrl.href,
	name: normalizedTitle,
	description,
	inLanguage: 'lv-LV',
	isPartOf: {
		'@id': `${siteUrl}/#website`,
	},
	about: {
		'@id': `${siteUrl}/#business`,
	},
	author: {
		'@id': `${siteUrl}/#business`,
	},
	publisher: {
		'@id': `${siteUrl}/#business`,
	},
};
const schemaGraph = [organizationSchema, websiteSchema, pageSchema, ...(Array.isArray(structuredData) ? structuredData : structuredData ? [structuredData] : [])];
---

<!doctype html>
<html lang="lv">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="shortcut icon" href="/favicon.ico" />
		<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
		<meta name="apple-mobile-web-app-title" content="Liepajas Teltis" />
		<link rel="manifest" href="/site.webmanifest" />
		<link rel="canonical" href={canonicalUrl.href} />
		<meta name="description" content={description} />
		<meta
			name="robots"
			content={noindex ? 'noindex, nofollow' : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1'}
		/>
		<meta name="application-name" content="Liepājas Teltis" />
		<meta name="theme-color" content="#6B7A4A" />
		<meta name="color-scheme" content="light only" />
		<meta property="og:site_name" content="Liepājas teltis" />
		<meta property="og:type" content="website" />
		<meta property="og:locale" content="lv_LV" />
		<meta property="og:title" content={normalizedTitle} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonicalUrl.href} />
		<meta property="og:image" content={imageUrl.href} />
		<meta property="og:image:secure_url" content={imageUrl.href} />
		{imageType && <meta property="og:image:type" content={imageType} />}
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content="Liepājas teltis pasākumu telšu un inventāra noma" />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={normalizedTitle} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={imageUrl.href} />
		<meta name="twitter:image:alt" content="Liepājas teltis pasākumu telšu un inventāra noma" />
		<meta name="generator" content={Astro.generator} />
		<script type="application/ld+json" set:html={JSON.stringify({ '@context': 'https://schema.org', '@graph': schemaGraph })} />
		<script
			is:inline
			set:html={`(() => {
				try {
					if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
						document.documentElement.classList.add('motion-preload');
					}
				} catch {
					document.documentElement.classList.add('motion-preload');
				}
			})();`}
		/>
		<title>{normalizedTitle}</title>
		{
			resetScrollOnLoad && (
				<script
					is:inline
					set:html={`(() => {
						if (window.location.hash) return;
						if ('scrollRestoration' in history) history.scrollRestoration = 'manual';
						window.scrollTo(0, 0);
						window.addEventListener('pageshow', () => {
							if (!window.location.hash) requestAnimationFrame(() => window.scrollTo(0, 0));
						});
					})();`}
				/>
			)
		}
	</head>

	<body>
		<slot />

		<CartDrawer />
		<CookieConsent />
		<ScrollAnimations />
	</body>
</html>

---
const actions = [
	{
		label: 'Rakstīt WhatsApp',
		href: 'https://wa.me/37129373231',
		icon: 'whatsapp',
		target: '_blank',
		rel: 'noopener noreferrer',
	},
	{
		label: 'Zvanīt uz +371 29 373 231',
		href: 'tel:+37129373231',
		icon: 'phone',
	},
];
---

<nav class="floating-actions" aria-label="Ātrie kontakti" data-floating-actions>
	{
		actions.map((action) => (
			<a
				class="floating-actions__button"
				href={action.href}
				target={action.target}
				rel={action.rel}
				aria-label={action.label}
				title={action.label}
			>
				{
					action.icon === 'whatsapp' ? (
						<img src="/icons/whatsapp.svg" alt="" loading="eager" decoding="async" />
					) : (
						<svg aria-hidden="true" viewBox="0 0 24 24" focusable="false">
							<path d="M20.6 16.8v2.9a1.9 1.9 0 0 1-2.1 1.9 18.8 18.8 0 0 1-8.2-2.9A18.5 18.5 0 0 1 4.6 13 18.8 18.8 0 0 1 1.7 4.8 1.9 1.9 0 0 1 3.6 2.7h2.9a1.9 1.9 0 0 1 1.9 1.6c.1 1 .4 2 .7 2.9a1.9 1.9 0 0 1-.4 2l-1.2 1.2a15.1 15.1 0 0 0 5.7 5.7l1.2-1.2a1.9 1.9 0 0 1 2-.4c.9.3 1.9.6 2.9.7a1.9 1.9 0 0 1 1.3 1.6Z" />
						</svg>
					)
				}
			</a>
		))
	}
</nav>

<script>
	const floatingActions = document.querySelector<HTMLElement>('[data-floating-actions]');
	const mobileViewport = window.matchMedia('(max-width: 640px)');

	const syncFloatingActions = () => {
		if (!floatingActions) return;
		floatingActions.classList.toggle('is-visible', !mobileViewport.matches || window.scrollY > 24);
	};

	window.addEventListener('scroll', syncFloatingActions, { passive: true });
	mobileViewport.addEventListener('change', syncFloatingActions);
	syncFloatingActions();
</script>
